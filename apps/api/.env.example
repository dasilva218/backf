# ─── Base de données ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:motdepasse@hote:5432/find_delivery

# ─── Authentification ───────────────────────────────────────────────────────
JWT_SECRET=
# Durée des sessions. Client et admin : 30 min par défaut. Livreur : 12 h par
# défaut (une journée de travail) ; le statut du compte est relu à chaque
# requête, une suspension reste donc immédiate.
# JWT_EXPIRES_IN=30m
# JWT_EXPIRES_IN_LIVREUR=12h
PORT=3001

# Nombre de proxys de confiance devant l'API (Traefik/Coolify : 1). 0 ou absent
# si l'API est exposée directement : sinon un client choisirait son IP vue par
# le limiteur de débit via X-Forwarded-For.
TRUST_PROXY=0

# ─── Mot de passe oublié (e-mail via Resend) ────────────────────────────────
# RESEND_API_KEY   — clé d'API Resend (re_…). Absente : aucun e-mail ne part ;
#                    en développement, le lien est alors écrit dans les logs.
# EMAIL_EXPEDITEUR — expéditeur sur un domaine VÉRIFIÉ dans Resend (DNS),
#                    ex. « Avoo <no-reply@mon-domaine> ».
# WEB_URL          — racine du site client, sans barre finale : le lien de
#                    l'e-mail pointe sur <WEB_URL>/reinitialiser-mot-de-passe.
#                    Obligatoire en production (défaut dev : http://localhost:3000).
RESEND_API_KEY=
EMAIL_EXPEDITEUR=
WEB_URL=

# Swagger (/api) n'est servi en production que si SWAGGER=1.
# SWAGGER=1

# ─── Intégration Ewuang ─────────────────────────────────────────────────────
#
# Contrat : ewuang-web/docs/contrat-api-partenaires.md
#
# EWUANG_API_URL  — racine de l'API, SANS barre finale.
#                   Production : https://ewuang.ga/api
#                   Local      : http://localhost:3000/api
#
# EWUANG_API_KEY  — la clé du partenaire, de la forme `ewp_<8hex>_<64hex>`.
#                   Transmise dans l'en-tête `X-Ewuang-Cle`, JAMAIS dans
#                   `Authorization` : côté Ewuang cet en-tête porte déjà les
#                   jetons de ses propres utilisateurs.
#                   Elle n'est affichée QU'UNE FOIS, à la création du partenaire
#                   dans /dashboard/partenaires. Perdue, elle se régénère — ce
#                   qui invalide l'ancienne.
#
# EWUANG_WEBHOOK_SECRET — secret de signature, de la forme `whsec_<64hex>`.
#                   DISTINCT de la clé d'API, remis en même temps qu'elle.
#                   Sert à vérifier le HMAC des webhooks entrants. S'il est
#                   absent, l'endpoint /api/v1/ewuang/webhook refuse TOUT :
#                   accepter faute de pouvoir vérifier ferait d'un oubli de
#                   configuration un endpoint ouvert à qui connaît l'URL.
#
# L'URL à déclarer côté Ewuang est celle de CE service :
#   https://<ce-domaine>/api/v1/ewuang/webhook
#
EWUANG_API_URL=https://ewuang.ga/api
EWUANG_API_KEY=
EWUANG_WEBHOOK_SECRET=
