enum TypeMouvementEspeces {
  /// Livreur : espèces reçues à une étape de course (frais et marchandise).
  ENCAISSEMENT
  /// Livreur : sa part de la course, qu'il garde. Posée à la fin (LIVREE ou RETOURNEE).
  REMUNERATION
  /// Livreur → find_delivery, contre un reçu.
  VERSEMENT
  /// find_delivery → livreur, quand son solde est négatif.
  PAIEMENT_LIVREUR
  /// Client : contre-remboursement encaissé pour lui à la remise.
  MARCHANDISE
  /// find_delivery → client.
  REVERSEMENT
  /// Ewuang : espèces encaissées par un de ses livreurs sur une de nos courses
  /// (webhook v2). Ewuang en répond devant nous (R7).
  ENCAISSEMENT_EWUANG
  /// Ewuang : ce que la course nous coûte chez lui (`tarifEwuang`, + forfait
  /// retour sur un retour). Il le garde sur ce qu'il a encaissé.
  TARIF_EWUANG
  /// Ewuang → find_delivery, au règlement du relevé, contre un reçu.
  REGLEMENT_EWUANG_RECU
  /// find_delivery → Ewuang, quand le relevé est en sa faveur.
  REGLEMENT_EWUANG_VERSE
}

