generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String          @id @default(uuid())
  name            String?
  email           String          @unique
  emailVerified   Boolean         @default(false)
  status          AccountStatus   @default(ACTIVE)
  image           String?
  role            UserRole        @default(CLIENT)
  password        String
  adminProfile    Admin?
  clientProfile   Client?
  livreurProfile  Livreur?
  notifications   Notification[]
  supportTickets  SupportTicket[]
  accounts        Account[]
  sessions        Session[]
  reglementsSaisis MouvementEspeces[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("user")
}

model Admin {
  id           String        @id @default(uuid())
  firstname    String
  lastname     String
  phoneAirtel  String?
  phoneMoov    String?
  userAdminId  String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userAdminId], references: [id], onDelete: Cascade)
  documents    Document[]
  gains        Gain[]
  transactions Transaction[]
}

/// Celui qui commande une course : particulier, entreprise ou boutique.
///
/// Une boutique n'est qu'un type de client parmi d'autres (décision du
/// 2026-10-23). `firstname` / `lastname` désignent la personne à contacter ;
/// `raisonSociale` le nom de l'entreprise ou de la boutique, obligatoire pour
/// ces deux types (contrôlé par le DTO, pas en base).
model Client {
  id                 String        @id @default(uuid())
  type               TypeClient
  raisonSociale      String?
  firstname          String
  lastname           String
  phoneAirtel        String?
  phoneMoov          String?
  address            String?
  userClientId       String        @unique
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  user               User          @relation(fields: [userClientId], references: [id], onDelete: Cascade)
  documents          Document[]
  evaluationsDonnees Evaluation[]  @relation("EvaluationsDonnees")
  evaluations        Evaluation[]  @relation("EvaluationsRecues")
  livraisons         Livraison[]
  transactions       Transaction[]
  mouvementsEspeces  MouvementEspeces[]
}

model Livreur {
  id                 String        @id @default(cuid())
  firstname          String
  lastname           String
  phoneAirtel        String?
  phoneMoov          String?
  address            String?
  userLivreurId      String        @unique
  moyenTransport     TransportMode
  immatriculation    String?
  zoneGeographique   String[]
  ville              String?
  scoreGlobal        Float         @default(0)
  nombreLivraisons   Int           @default(0)
  /// En service : il reçoit les annonces de courses. Basculé par le livreur.
  estDisponible      Boolean       @default(true)

  /// Dossier vérifié par un ADMIN, pièces en main, au bureau (pas de dépôt de
  /// fichiers au lancement). Aucune course n'est proposée ni acceptée avant
  /// VALIDE : c'est la garde du KYC, comme `is_verified` chez Ewuang.
  statutDossier      StatutDossier @default(EN_ATTENTE)
  motifRefus         String?
  dossierTraiteAt    DateTime?     @db.Timestamptz
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  documents          Document[]
  evaluationsDonnees Evaluation[]  @relation("EvaluationsDonnees")
  evaluations        Evaluation[]  @relation("EvaluationsRecues")
  gains              Gain[]
  livraisons         Livraison[]
  user               User          @relation(fields: [userLivreurId], references: [id], onDelete: Cascade)
  transactions       Transaction[]
  mouvementsEspeces  MouvementEspeces[]

  @@index([userLivreurId])
  @@index([ville])
  @@index([estDisponible])
}

model Document {
  id         String    @id @default(uuid())
  type       String
  url        String
  adminId    String?
  clientId   String?
  livreurId  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  admin      Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  livreur    Livreur?  @relation(fields: [livreurId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([adminId])
}

model Colis {
  id          String    @id @default(cuid())
  description String
  type        TypeColis
  poids       Float?
  volume      Float?
  livraisonId String
  createdAt   DateTime  @default(now())
  livraison   Livraison @relation(fields: [livraisonId], references: [id], onDelete: Cascade)

  @@index([livraisonId])
}

model Livraison {
  id         String  @id @default(cuid())
  livreurId  String?
  clientId   String?

  // ─── Rattachement à la mission Ewuang ────────────────────────────────────
  //
  // Cette plateforme n'a pas de livreurs : chaque course est dispatchée à
  // Ewuang, qui l'exécute avec sa flotte. Ces champs sont la couture entre les
  // deux bases.
  //
  // `referenceExterne` est NOTRE identifiant, envoyé dans POST /partenaires/
  // missions ; Ewuang en fait sa clé d'idempotence, donc le même appel rejoué
  // ne crée pas deux courses. Unique ici aussi : c'est ce qui garantit qu'on ne
  // l'émet jamais pour deux courses différentes.
  //
  // `missionEwuangId` est l'identifiant rendu par Ewuang. Nullable parce qu'il
  // n'existe qu'APRÈS un POST réussi : une course créée localement et dont
  // l'appel a échoué doit rester visible et rejouable, pas disparaître.
  referenceExterne String? @unique
  missionEwuangId  String? @unique

  /// Statut d'Ewuang, repris TEL QUEL : « En attente », « En cours de
  /// livraison », « Colis récupéré », « Livrée », « Annulée », « Reportée ».
  ///
  /// Texte et non enum, volontairement. Ce statut appartient à l'autre système :
  /// une valeur qu'Ewuang ajouterait et qu'un enum local ignorerait ferait
  /// échouer le webhook, donc relancer, donc bloquer la mission — une panne
  /// causée par notre propre modèle. Le champ `statut` ci-dessous reste le
  /// vocabulaire interne de l'écran ; celui-ci fait foi.
  statutEwuang String?

  /// Code de remise à quatre chiffres, généré par Ewuang à la création.
  /// C'est à NOUS de le transmettre au destinataire : le livreur le lui
  /// réclamera à la remise, et sans lui la course ne peut pas se clôturer.
  codeRemise String?

  // ─── Instantané du livreur ───────────────────────────────────────────────
  //
  // Un instantané, pas une clé étrangère : le livreur n'existe pas dans cette
  // base et n'y existera pas. Ces trois champs sont figés à l'attribution, par
  // le webhook `mission.attribuee`. Les figer est ce qui permet de relire une
  // course d'il y a six mois avec le nom qu'elle portait alors, même si le
  // livreur a quitté Ewuang. Pour l'état VIVANT — position, en ligne, occupé —
  // on interroge GET /api/partenaires/flotte, on ne le stocke pas.
  livreurEwuangId      String?
  livreurNom           String?
  livreurContact       String?
  livreurTypeVehicule  String?

  // ─── Le destinataire ─────────────────────────────────────────────────────
  //
  // Simple contact, sans compte : Ewuang ne lui en crée pas et nous n'avons pas
  // à lui en créer un. `adresseArrivee` porte déjà son adresse.
  destinataireNom     String?
  destinataireContact String?

  // ─── L'argent de la course ───────────────────────────────────────────────
  //
  // Renvoyés par POST /partenaires/missions et stockés tels quels. `tarif`
  // ci-dessous est ce que paie le client ; `tarifEwuang` est ce que la course
  // nous coûte. Sans les deux, la marge de l'activité n'est lisible d'aucun
  // côté.
  //
  // `remunerationLivreur` est servi au partenaire parce qu'il est le payeur —
  // Ewuang le masque en revanche à ses propres livreurs, qui n'ont pas à lire
  // la marge par soustraction.
  tarifEwuang         Int?
  remunerationLivreur Int?

  /// Qui paie les frais, en espèces, au livreur : l'expéditeur à
  /// l'enlèvement ou le destinataire à la remise. Choisi par le client à la
  /// commande et exigé par l'API pour toute nouvelle course.
  ///
  /// Null = course réglée hors course : ce sont les courses créées avant le
  /// paiement en espèces (2026-10-23). Même sens qu'un bloc `paiement` absent
  /// dans la v2 du contrat Ewuang.
  payeur Payeur?

  /// Contre-remboursement : prix de la marchandise que le livreur encaisse
  /// auprès du DESTINATAIRE, à la remise, pour le compte du client. 0 = aucun.
  /// Ce n'est pas un revenu de find_delivery : il est dû au client. CHECK en
  /// base : positif, et jamais sans `payeur`.
  montantMarchandise Int @default(0)

  // ─── La flotte qui exécute la course ─────────────────────────────────────
  //
  // La course est proposée en même temps à la flotte find_delivery et à
  // Ewuang ; la première qui l'obtient la garde. `flotte` ne passe de null à
  // une valeur QUE par une mise à jour conditionnée par `flotte: null` : c'est
  // le verrou qui empêche deux livreurs sur une même course.
  //
  // FIND_DELIVERY : `statut` fait foi, et les événements d'Ewuang sur cette
  // mission (son annulation, d'abord) sont ignorés. EWUANG : `statutEwuang`
  // fait foi, comme avant.
  flotte Flotte?

  /// Réservation accordée à un livreur Ewuang (v2 du contrat, §1), qui pose
  /// `flotte = EWUANG` avant même l'attribution. Confirmée par
  /// `mission.attribuee` (`dateAcceptation`) ; sans elle au bout de 10 min, la
  /// course redevient libre (src/livraisons/flotte.ts). Null hors réservation.
  reserveeEwuangAt DateTime? @db.Timestamptz

  /// Essais du code de remise, consommés AVANT la comparaison (voir
  /// livreur-courses.service.ts). Au 5e, seul un ADMIN clôture la course.
  tentativesCode Int @default(0)

  /// Arrivée du livreur chez le destinataire. Ouvre, 10 min plus tard, le
  /// droit de déclarer un échec de remise (règle R3).
  arriveeDestinationAt DateTime? @db.Timestamptz

  /// Espèces que le livreur déclare avoir reçues, à chaque étape où quelque
  /// chose est dû. Montant exact exigé (règle R2 : pas de paiement partiel).
  /// Chacun a son écriture ENCAISSEMENT dans `MouvementEspeces`.
  montantEncaisseEnlevement Int?
  encaisseEnlevementAt      DateTime? @db.Timestamptz
  montantEncaisseRemise     Int?
  encaisseRemiseAt          DateTime? @db.Timestamptz

  /// Colis rendu à l'expéditeur après un échec de remise (statut RETOURNEE).
  /// Si le destinataire devait payer les frais, l'expéditeur les doit alors
  /// (règle R3) : ils sont encaissés à ce moment-là.
  dateRetour            DateTime? @db.Timestamptz
  montantEncaisseRetour Int?
  encaisseRetourAt      DateTime? @db.Timestamptz

  /// `emis_at` du dernier événement appliqué à cette mission.
  ///
  /// L'ordre de livraison des webhooks n'est pas garanti : un
  /// `mission.attribuee` relancé peut arriver après un `mission.livree`. Sans
  /// cette borne, il écraserait un statut plus récent par un plus ancien, et la
  /// course repartirait en arrière sans que rien ne le signale.
  ///
  /// `@db.Timestamptz` et non le `TIMESTAMP(3)` que Prisma pose par défaut :
  /// celui-ci est SANS fuseau, et le Gabon est à UTC+1. Une date naïve stockée
  /// en UTC puis relue comme locale décale tout filtre par jour d'une heure —
  /// une course de 00h30 tombe la veille. Toute nouvelle colonne de date de ce
  /// schéma doit porter cette annotation.
  dernierEvenementAt DateTime? @db.Timestamptz

  // ─── La demande du client ────────────────────────────────────────────────
  //
  // La zone d'arrivée et le type fixent notre prix (`tarif`) ; le départ est
  // conservé mais n'entre pas dans le prix. Le contrat Ewuang ne connaît
  // qu'une zone : on lui envoie `zoneArrivee`, qui est chez lui la ville de
  // destination.
  typeCourse  String?
  zoneDepart  String?
  zoneArrivee String?

  /// Corps EXACT de POST /partenaires/missions, tel qu'envoyé la première fois.
  ///
  /// Ewuang est idempotent sur `reference_externe`, mais seulement à corps
  /// identique : un corps différent répond 409. Rejouer après un timeout exige
  /// donc de renvoyer ce corps-ci, pas de le reconstruire depuis les colonnes
  /// (un profil client modifié entre-temps changerait le contact d'enlèvement).
  chargeEwuang Json?

  /// Dernier refus ou échec de transmission à Ewuang. Null quand la mission est
  /// créée. Une course sans `missionEwuangId` et avec ce champ renseigné est
  /// « non transmise » : elle se rejoue par POST /livraisons/:id/renvoyer.
  erreurEwuang String?

  adresseDepart    String
  latitudeDepart   Float?
  longitudeDepart  Float?
  adresseArrivee   String
  latitudeArrivee  Float?
  longitudeArrivee Float?
  distance         Float?
  tarif            Int?            @default(0)
  commission       Int?            @default(0)
  statut           StatutLivraison @default(EN_ATTENTE)
  dateDemande      DateTime        @default(now())
  dateAcceptation  DateTime?
  dateRecuperation DateTime?
  dateLivraison    DateTime?
  dateAnnulation   DateTime?
  noteClient       String?
  noteLivreur      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  colis            Colis[]
  evaluation       Evaluation?
  client           Client?         @relation(fields: [clientId], references: [id])
  livreur          Livreur?        @relation(fields: [livreurId], references: [id])
  suivisPosition   SuiviPosition[]
  transactions     Transaction[]
  mouvementsEspeces MouvementEspeces[]

  @@index([clientId])
  @@index([livreurId])
  @@index([statut])
  @@index([dateDemande])
  @@index([statutEwuang])
  @@index([livreurEwuangId])
  @@index([flotte])
}

/// Journal des webhooks reçus d'Ewuang.
///
/// Ewuang livre ses événements AU MOINS UNE FOIS : sur timeout ou sur une
/// réponse ≥ 400, il relance avec un délai croissant. Les doublons ne sont donc
/// pas hypothétiques, ils sont certains. `evenementId` unique est ce qui les
/// absorbe — sans lui, un changement de statut s'applique deux fois.
///
/// La table garde aussi la charge utile brute. C'est ce qui permet de rejouer
/// un événement qu'un bug local a mal traité, sans redemander à Ewuang de le
/// renvoyer : il ne le fera pas, pour lui il a été acquitté.
model EvenementEwuangRecu {
  id          String   @id @default(cuid())
  /// `evenement_id` du corps, repris aussi dans l'en-tête X-Ewuang-Evenement.
  evenementId String   @unique
  type        String
  /// Nullable : un événement dont la mission est inconnue ici est conservé
  /// plutôt que rejeté, sinon il est perdu pour de bon.
  missionEwuangId String?
  /// Horodatage d'ÉMISSION côté Ewuang, pas de réception : c'est lui qui
  /// ordonne les événements d'une même mission.
  ///
  /// `@db.Timestamptz` sur les trois dates de cette table — voir
  /// `Livraison.dernierEvenementAt` : le défaut de Prisma est sans fuseau, et
  /// comparer un instant naïf à un autre venu d'un `Z` est une fausse
  /// comparaison d'une heure au Gabon. Ici elle casserait la règle d'ordre.
  emisAt      DateTime  @db.Timestamptz
  charge      Json
  recuAt      DateTime  @default(now()) @db.Timestamptz
  /// Null tant que l'événement n'a pas été appliqué. Un doublon acquitté sans
  /// retraitement garde la date du premier passage.
  traiteAt    DateTime? @db.Timestamptz
  /// Renseigné quand l'événement a été délibérément NON appliqué : mission
  /// inconnue, ou plus ancien que le dernier appliqué. Un rejet silencieux
  /// serait indébogable.
  ignoreMotif String?

  @@index([missionEwuangId])
  @@index([type])
  @@index([recuAt])
  @@index([traiteAt])
}

model SuiviPosition {
  id          String    @id @default(cuid())
  livraisonId String
  latitude    Float
  longitude   Float
  timestamp   DateTime  @default(now())
  livraison   Livraison @relation(fields: [livraisonId], references: [id], onDelete: Cascade)

  @@index([livraisonId])
  @@index([timestamp])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      TypeNotification
  titre     String
  message   String
  lue       Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lue])
  @@index([createdAt])
}

model Evaluation {
  id                      String    @id @default(cuid())
  livraisonId             String    @unique
  noteVersLivreur         Int?
  commentaireVersLivreur  String?
  noteVersClient          Int?
  commentaireVersClient   String?
  livreurEvaluateurId     String?
  livreurEvalueId         String?
  clientEvaluateurId      String?
  clientEvalueId          String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  clientEvaluateur        Client?   @relation("EvaluationsDonnees", fields: [clientEvaluateurId], references: [id])
  clientEvalue            Client?   @relation("EvaluationsRecues", fields: [clientEvalueId], references: [id])
  livraison               Livraison @relation(fields: [livraisonId], references: [id], onDelete: Cascade)
  livreurEvaluateur       Livreur?  @relation("EvaluationsDonnees", fields: [livreurEvaluateurId], references: [id])
  livreurEvalue           Livreur?  @relation("EvaluationsRecues", fields: [livreurEvalueId], references: [id])

  @@index([livraisonId])
  @@index([livreurEvalueId])
  @@index([clientEvalueId])
}

model Transaction {
  id               String            @id @default(cuid())
  livraisonId      String?
  clientId         String?
  livreurId        String?
  adminId          String?
  type             TypeTransaction
  montant          Float
  commission       Float?
  modePaiement     ModePaiement
  statut           StatutTransaction @default(EN_ATTENTE)
  referenceExterne String?
  recu             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  admin            Admin?            @relation(fields: [adminId], references: [id], onDelete: Cascade)
  client           Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  livraison        Livraison?        @relation(fields: [livraisonId], references: [id], onDelete: Cascade)
  livreur          Livreur?          @relation(fields: [livreurId], references: [id], onDelete: Cascade)

  @@index([livraisonId])
  @@index([clientId])
  @@index([livreurId])
  @@index([statut])
  @@index([createdAt])
}

/// Registre des espèces (phase 3) : qui doit combien à qui.
///
/// Une écriture par mouvement, jamais modifiée ni supprimée (trigger en base) :
/// une erreur de saisie se corrige par l'écriture inverse. `montant` est
/// toujours positif ; le sens se lit dans `type` (src/especes/especes.ts).
///
/// Deux comptes seulement, car find_delivery est la contrepartie de tout :
/// - LIVREUR (ENCAISSEMENT, REMUNERATION, VERSEMENT, PAIEMENT_LIVREUR) : solde
///   positif = espèces qu'il détient pour find_delivery ; négatif =
///   find_delivery lui doit de l'argent (un retour coûte plus que la course).
/// - CLIENT (MARCHANDISE, REVERSEMENT) : contre-remboursement encaissé pour lui
///   et pas encore reversé.
/// - EWUANG (ENCAISSEMENT_EWUANG, TARIF_EWUANG, REGLEMENT_EWUANG_*), ni livreur
///   ni client : solde positif = Ewuang nous doit (ses livreurs ont encaissé
///   plus que ce que nos courses lui coûtent).
/// La commission de find_delivery n'a pas de compte : c'est `Livraison.commission`.
///
/// Les écritures d'une course sont posées dans la MÊME transaction que l'étape
/// qui les cause ; `cle` unique (`<livraisonId>:<etape>`) en est le filet.
model MouvementEspeces {
  id          String               @id @default(cuid())
  type        TypeMouvementEspeces
  montant     Int
  livreurId   String?
  clientId    String?
  livraisonId String?
  /// `<livraisonId>:<etape>` pour une course ; `recu:<numéro>` pour un
  /// règlement saisi par un ADMIN, le numéro du reçu papier.
  cle         String               @unique
  /// L'ADMIN qui a saisi un règlement. Null pour une écriture de course.
  saisiParId  String?
  note        String?
  createdAt   DateTime             @default(now()) @db.Timestamptz
  // Restrict : un livreur, un client ou une course qui a mouvementé de
  // l'argent ne se supprime pas, l'historique de caisse disparaîtrait avec.
  livreur     Livreur?             @relation(fields: [livreurId], references: [id], onDelete: Restrict)
  client      Client?              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  livraison   Livraison?           @relation(fields: [livraisonId], references: [id], onDelete: Restrict)
  saisiPar    User?                @relation(fields: [saisiParId], references: [id], onDelete: Restrict)

  @@index([livreurId, createdAt])
  @@index([clientId, createdAt])
  @@index([livraisonId])
}

model Gain {
  id          String   @id @default(cuid())
  livreurId   String?
  adminId     String?
  montant     Int
  date        DateTime @default(now())
  description String
  admin       Admin?   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  livreur     Livreur? @relation(fields: [livreurId], references: [id], onDelete: Cascade)

  @@index([livreurId])
  @@index([date])
}

model SupportTicket {
  id          String           @id @default(cuid())
  userId      String
  sujet       String
  description String
  priorite    PrioriteTicket   @default(MOYENNE)
  statut      StatutTicket     @default(OUVERT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  messages    MessageSupport[]
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([statut])
}

model MessageSupport {
  id        String        @id @default(cuid())
  ticketId  String
  auteur    String
  message   String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum UserRole {
  CLIENT
  LIVREUR
  ADMIN
}

enum TypeClient {
  PARTICULIER
  ENTREPRISE
  BOUTIQUE
}

enum Payeur {
  EXPEDITEUR
  DESTINATAIRE
}

enum Flotte {
  FIND_DELIVERY
  EWUANG
}

enum StatutDossier {
  EN_ATTENTE
  VALIDE
  REFUSE
}

